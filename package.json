  "description": "FragPDF — la boîte à outils PDF complète, 100% dans votre navigateur",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "test:e2e": "node scripts/e2e.mjs",
    "predev": "node scripts/copy-assets.mjs",
    "prebuild": "node scripts/copy-assets.mjs",
    "test:unit": "node --import ./scripts/register-loader.mjs --test scripts/unit.mjs",
    "test": "npm run test:unit && npm run build && npm run test:smoke && npm run test:e2e"
  },
